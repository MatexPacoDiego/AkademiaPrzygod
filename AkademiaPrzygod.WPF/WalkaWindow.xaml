<Window x:Class="AkademiaPrzygod.WPF.WalkaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AkademiaPrzygod.WPF"
        mc:Ignorable="d"
        Title="⚔️ Akademia Przygód - Walka" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a2e">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Statystyki bohatera -->
        <local:StatystykiControl x:Name="statsControl"
                                 Grid.Column="0" Grid.RowSpan="4"
                                 VerticalAlignment="Top"/>

        <!-- HP wroga -->
        <Border Grid.Column="1" Grid.Row="0"
                Background="#0f3460" CornerRadius="8"
                Padding="12" Margin="15,0,0,10">
            <StackPanel>
               
                <TextBlock x:Name="tbNazwaWroga"
                           Foreground="#ef4444"
                           Margin="0,0,0,4" 
                           FontSize="16" FontWeight="Bold"/>
                
                <TextBlock x:Name="tbGatunekWroga"
                           Foreground="#888" FontSize="12" Margin="0,0,0,6"/>
                <TextBlock Text="❤️ HP wroga:" Foreground="#888" FontSize="11"/>
                <ProgressBar x:Name="pbHPWroga"
                             Height="12" Minimum="0" Maximum="100"
                             Foreground="#ef4444" Background="#333"
                             Margin="0,4,0,2"/>
                <TextBlock x:Name="tbHPWroga"
                           Foreground="#ef4444" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Canvas z animacja -->
        <Border Grid.Column="1" Grid.Row="1"
                Background="#0d1117" CornerRadius="8"
                Margin="15,0,0,10">
            <Canvas x:Name="walkaCanvas">
                <!-- Bohater -->
                <StackPanel x:Name="bohaterPanel" Canvas.Left="60" Canvas.Top="30">
                    <TextBlock x:Name="tbBohaterEmotka"
                               Foreground="#e0e0e0"
                               FontSize="55" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="tbBohaterNazwa"
                               Foreground="#e0e0e0" FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Wrog -->
                <StackPanel x:Name="wrogPanel" Canvas.Top="30">
                    <TextBlock x:Name="tbWrogEmotka"
                               Foreground="#ef4444"
                               FontSize="55" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="tbWrogNazwa"
                               Foreground="#ef4444" FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Canvas>
        </Border>

        <!-- Log walki -->
        <Border Grid.Column="1" Grid.Row="2"
                Background="#0d1117" CornerRadius="8"
                Margin="15,0,0,10">
            <ScrollViewer x:Name="logScroll"
                          VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="tbLog"
                         Background="Transparent"
                         Foreground="#aaa"
                         FontSize="12"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Padding="10"/>
            </ScrollViewer>
        </Border>

        <!-- Przyciski -->
        <Border  x:Name="btnOk" Grid.Column="1" Grid.Row="3" Height="45" Margin="15,0,0,0"  Background="#533AB7" CornerRadius="8" Visibility="Collapsed">
            <Button 
                     Height="40" Margin="0,0,5,0"
                    FontSize="14" FontWeight="Bold"
                    Background="Transparent" Foreground="White"
                    BorderThickness="0"
                    Click="BtnOk_Click">
               
                    <TextBlock Text="✅ OK" FontSize="14" Foreground="White"/>
               
            </Button>
        </Border>

        <Grid Grid.Column="1" Grid.Row="3" Margin="15,0,0,0" x:Name="buttonsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Height="45" Background="#533AB7" CornerRadius="8">
            <Button  x:Name="btnAtak"
                    Height="40" Margin="0,0,5,0"
                    FontSize="14" FontWeight="Bold"
                    Background="Transparent" Foreground="White"
                     BorderThickness="0"
                    Click="BtnAtak_Click">
              
                    <TextBlock Text="⚔️ Atak" FontSize="14" Foreground="White"/>
              
            </Button>
            </Border>

            <Border Grid.Column="1" Margin="5,0,5,0" Height="45" Background="#0f3460" CornerRadius="8">
                <Button  x:Name="btnPrzedmiot"
                    Height="40"
                    FontSize="14"
                    Background="Transparent"
                     Foreground="White"
                         BorderThickness="0"
                    Click="BtnPrzedmiot_Click">
                    
                        <TextBlock Text="🧪 Przedmiot" FontSize="14" Foreground="White"/>
                   
                </Button>
            </Border>

            <Border Margin="5,0,0,0" Grid.Column="2" Background="#333" Height="45" CornerRadius="8">
                <Button x:Name="btnUcieknij"
                    Height="40" 
                    FontSize="14"
                    Background="Transparent" Foreground="White"
                    BorderThickness="0"
                    Click="BtnUcieknij_Click">
               
                    <TextBlock Text="🏃 Ucieknij" FontSize="14" Foreground="White"/>
                
            </Button>
            </Border>
        </Grid>
    </Grid>
</Window>