<Window x:Class="AkademiaPrzygod.WPF.TworzeniePostaci"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AkademiaPrzygod.WPF"
        mc:Ignorable="d"
        Title="⚔️ Akademia Przygód - Tworzenie Postaci" Height="600" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a2e">
    <Grid>
        <!--header - app-->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10">
            <TextBlock Text="⚔️" 
               FontSize="20" 
               Foreground="Gold" 
               HorizontalAlignment="Center"
               />

            <TextBlock Text="AKADEMIA PRZYGÓD" 
               FontSize="20" 
               FontWeight="Bold" 
               HorizontalAlignment="Center" 
               Foreground="#e0e0e0"
               />
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">


            <!--header -->
            <TextBlock Text="🧝 " 
               FontSize="60" 
               Foreground="Gold" 
               HorizontalAlignment="Center"
               Margin="0,40,0,10" 
               />
            <TextBlock Text="TWORZENIE POSTACI" 
               FontSize="28" 
               FontWeight="Bold" 
               HorizontalAlignment="Center" 
               Foreground="#e0e0e0"
               Margin="0,0,0,20" 
               />

            <!--Imie-->
            <TextBlock Text="Podaj imię bohatera:"
                       Foreground="#888" 
                       FontSize="14" 
                       Margin="0,0,0,6"/>
           
            <TextBox x:Name="txtbImie"
                     Width="300"
                     Height="36"
                     FontSize="14"
                     Background="#0f3460"
                     Foreground="White"
                     BorderBrush="#533ab7"
                     BorderThickness="2"
                     Margin="0,0,0,20"
                     VerticalContentAlignment="Center"
                     Padding="4"
                     />
            
            <!--klasy-->
             <TextBlock Text="Wybierz klasę bohatera:"
                       Foreground="#888" 
                       FontSize="14" 
                       Margin="0,0,0,10"/>

            <RadioButton x:Name="rbWojownik" 
                         Content="⚔️ Wojownik   (HP: 120, Atak: 20, Obrona: 15)"
                         Foreground="White" 
                         FontSize="13"
                         Margin="0,0,0,8" 
                         IsChecked="True"
                         GroupName="klasaBohater"/>

            <RadioButton x:Name="rbMag" 
                         Content="✨ Mag            (HP:  80, Atak: 30, Obrona:  8)"
                         Foreground="White" 
                         FontSize="13"
                         Margin="0,0,0,8"
                         GroupName="klasaBohater"/>

            <RadioButton x:Name="rbLotrzyk" Content="🗡️ Łotrzyk        (HP: 100, Atak: 25, Obrona: 10)"
                     Foreground="White" FontSize="13"
                     Margin="0,0,0,50"
                     GroupName="klasaBohater"/>

            <!--buttons-->
            <!--StworzPostac-->
            <Border Margin="0,0,0,12"
                    Width="210"
                    Height="50"
                    Background="#533AB7"
                    CornerRadius="10"
                    >
                <Button x:Name="btnStworz" 
                        Content="➕ Stwórz Postać"
                        Width="200"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnStworz_Click"
                        />
            </Border>
            <!--button wroc-->
            <Border Margin="0,0,0,12"
                    Width="210"
                    Height="50"
                    Background="#333333"
                    CornerRadius="10"
                    >
                <Button x:Name="btnWroc" 
                        Content="⬅️ Wróć do menu"
                        Width="200"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnWroc_Click"
                        />
            </Border>



        </StackPanel>
    </Grid>
</Window>
