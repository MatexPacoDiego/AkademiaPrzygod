<Window x:Class="AkademiaPrzygod.WPF.KomunikatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AkademiaPrzygod.WPF"
        mc:Ignorable="d"
                Title="⚔ Akademia Przygód - Komunikat" Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a2e">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!--header-->
            <TextBlock Text="!" 
                       x:Name="tbKomunikat"
                       FontSize="60" 
                       Foreground="Red" 
                       Margin="0,0,0,10" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       />

            <TextBlock Text="KOMUNIKAT" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Foreground="#e0e0e0"
                       Margin="0,0,0,40"
                       />
            
            <TextBlock x:Name="tbWynik"
                       FontSize="20" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Foreground="#e0e0e0"
                       Margin="0,0,0,40"
                       />



            <!--wyjscie-->
            <Border Margin="0,0,0,12"
                    Width="210"
                    Height="50"
                    Background="#533AB7"
                    CornerRadius="10"
                    >
                <Button x:Name="btnOk" 
                        Content="✅ OK"
                        Width="200"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnOk_Click"
                        />
            </Border>



        </StackPanel>
    </Grid>
</Window>

