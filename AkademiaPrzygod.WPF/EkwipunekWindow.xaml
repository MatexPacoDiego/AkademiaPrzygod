<Window x:Class="AkademiaPrzygod.WPF.EkwipunekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AkademiaPrzygod.WPF"
        mc:Ignorable="d"
                Title="⚔️ Akademia Przygód - Ekwipunek"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a2e">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!--Statystyki kontrolka stworzone przez mnie-->
        <local:StatystykiControl x:Name="statsControl"/>

        <!--prawa kolumna-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                
            </Grid.RowDefinitions>
            <!--Naglowek-->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="0" Margin="0,10">
                <TextBlock Text="🎒 " 
                           FontSize="20" 
                           Foreground="Gold" 
                           HorizontalAlignment="Center"
                           />

                <TextBlock Text="TWÓJ EKWIPUNEK " 
                           FontSize="20" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Foreground="#e0e0e0"
                           />
            </StackPanel>

            <!--Lista ekwipunek-->
            <ListBox x:Name="listaEkwipunek"
                     Grid.Row="1"
                     Background="#0f3460"
                     Foreground="White"
                     FontSize="18"
                     BorderThickness="0"
                     Width="400"
                     Margin="0,30"
                     Padding="10"
                     />


            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>


                <!--uzyj-->
                <Border Margin="0,0,0,12"
                        Width="210"
                        Height="50"
                        Background="#533AB7"
                        CornerRadius="10"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        >
                    <Button x:Name="btnUzyj" 
                            Content="⚗️ Użyj"
                            Width="200"
                            Height="45"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnUzyj_Click"
                            />
                </Border>
                <!--wroc-->
                <Border x:Name="btnWroc"
                        Margin="0,0,0,12"
                        Width="210"
                        Height="50"
                        Background="#333333"
                        CornerRadius="10"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        >
                    <Button  
                            Content="⬅️ Wróć do menu"
                            Width="200"
                            Height="45"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnWroc_Click"
                            />
                </Border>
                <Border Margin="0,0,0,12"
                        x:Name="btnWrocWalka"
                        Width="210"
                        Height="50"
                        Background="#333333"
                        CornerRadius="10"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Visibility="Collapsed"
                        >
                    <Button  
                            Content="⬅️ Wróć do walki"
                            Width="200"
                            Height="45"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnWrocWalka_Click"
                            />
                </Border>

            </Grid>


        </Grid>





    </Grid>
</Window>

