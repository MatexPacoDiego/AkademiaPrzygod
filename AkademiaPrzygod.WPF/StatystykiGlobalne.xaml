<Window x:Class="AkademiaPrzygod.WPF.StatystykiGlobalne"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AkademiaPrzygod.WPF"
        mc:Ignorable="d"
        Title="⚔️ Akademia Przygód - Statystyki" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a2e">
    <Grid>
        <!--header - app-->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10">
            <TextBlock Text="⚔️" 
                       FontSize="20" 
                       Foreground="Gold" 
                       HorizontalAlignment="Center"
                       />

            <TextBlock Text="AKADEMIA PRZYGÓD" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Foreground="#e0e0e0"
                       />
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">


            <!--header -->
            <TextBlock Text="📊 " 
                       FontSize="30" 
                       Foreground="LightGreen" 
                       HorizontalAlignment="Center"
                       Margin="0,40,0,10" 
                       />
            <TextBlock Text="STATYSTYKI GLOBALNE" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Foreground="#e0e0e0"
                       Margin="0,0,0,40" 
                       />


            <!--Statystki-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="231*"/>
                    <ColumnDefinition Width="79*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🥊 Stoczone walki: "
                           Foreground="White"
                           FontSize="20"
                           Margin="0,10"
                           />
                <TextBlock x:Name="tbStatWalki"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Grid.Column="1"
                           Grid.Row="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           />
                <TextBlock Text="🔫 Zabici wrogowie: "
                           Foreground="White"
                           FontSize="20"
                           Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,10"
                           />
                <TextBlock x:Name="tbStatWrogowie"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Grid.Column="1"
                           Grid.Row="1"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           />
                <TextBlock Text="🧶 Zdobyte przedmioty: "
                           Foreground="White"
                           FontSize="20"
                           Grid.Row="2"
                           Grid.Column="0"
                           Margin="0,10"
                           
                           />
                <TextBlock x:Name="tbStatPrzedmioty"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Grid.Column="1"
                           Grid.Row="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Grid.RowSpan="2"
                           />

            </Grid>

            <Border Margin="0,30,0,12"
                    Width="210"
                    Height="50"
                    Background="#533AB7"
                    CornerRadius="10"
                    >
                <Button x:Name="btnWroc" 
                        Content="⬅️ Wróć do menu"
                        Width="200"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnWroc_Click"
                        />
            </Border>

        </StackPanel>
    </Grid>
</Window>

